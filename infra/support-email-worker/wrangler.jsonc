{
  "name": "starr-support-email",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // mimetext needs Node.js built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Addresses that get the portal auto-reply. Each needs its own Email Routing rule.
    "SUPPORT_ADDRESSES": "support@starr.app,info@starr.app",
    "PORTAL_URL": "https://support.starr.app"
  },
  // One auto-reply per sender per day. Create it with:
  //   npx wrangler kv namespace create REPLIED
  // and paste the id it prints below.
  "kv_namespaces": [
    { "binding": "REPLIED", "id": "3fb10c9166ae47f48b5f8ae9b4990326" }
  ]
}
